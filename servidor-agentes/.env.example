# Copie para .env no servidor (nunca suba o .env para o GitHub: este repositório é público).

# Modelo no formato fornecedor:modelo. Fornecedores: gemini, deepseek, anthropic
MODELO_PADRAO=gemini:gemini-flash-latest
# Opcional: outro modelo só para o coordenador
# MODELO_COORDENADOR=anthropic:claude-opus-5-5

# Chaves (preencha só as que for usar).
# Gemini: use uma chave do plano PAGO; no plano gratuito o Google pode usar os dados enviados.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# PostgreSQL com um usuário SOMENTE LEITURA (veja o README).
# Banco no próprio servidor do Docker: use host.docker.internal como endereço.
BANCO_URL=postgresql://agente_bi_leitura:SENHA@ENDERECO:5432/NOME_DO_BANCO
BANCO_TEMPO_MAXIMO_S=30
BANCO_LIMITE_LINHAS=200
